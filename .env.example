# Copy to .env. Never commit populated values. Paths below are for local development.
NODE_ENV=development
WEB_URL=http://localhost:3000
API_PORT=4000
PYTHON_URL=http://127.0.0.1:8000
PYTHON_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# These four values are public Firebase web configuration, not Admin credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_WEB_APP_ID
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_PROJECT_ID
# Local absolute path; ADC is also supported. Compose uses FIREBASE_ADMIN_FILE.
GOOGLE_APPLICATION_CREDENTIALS=REPLACE_WITH_ABSOLUTE_SERVICE_ACCOUNT_PATH
FIREBASE_ADMIN_FILE=./secrets/firebase-admin.json
MONGODB_URI=mongodb://127.0.0.1:27017/psm
# Compose only: choose a long URL-safe random password, not this placeholder.
MONGO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD
MONGO_APP_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_URL_SAFE_PASSWORD
# Generate at least 32 random characters; same value in Express and Python.
INTERNAL_SERVICE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
# Dummy placeholder: replace with the exact supported Llama 3.3 ID in your Groq account.
# This placeholder will not work; no model ID is assumed by the application.
GROQ_MODEL=REPLACE_WITH_SUPPORTED_GROQ_LLAMA_3_3_MODEL_ID
# No provider/model has been selected. Adapter accepts an OpenAI-compatible embeddings API.
EMBEDDING_PROVIDER=REPLACE_WITH_openai-compatible
EMBEDDING_MODEL=REPLACE_WITH_EXACT_IMMUTABLE_MODEL_VERSION
EMBEDDING_BASE_URL=REPLACE_WITH_HTTPS_API_BASE_ENDING_IN_V1
EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_API_KEY
PINECONE_API_KEY=REPLACE_WITH_PINECONE_KEY
PINECONE_INDEX=REPLACE_WITH_INDEX_NAME
PINECONE_CLOUD=aws
PINECONE_REGION=REPLACE_WITH_REGION
PINECONE_METRIC=cosine
# Optional assertion; infer dimension from a real embedding response before index creation.
PINECONE_DIMENSION=
# Optional local path overrides. Defaults are derived from the repository root.
# SOURCE_DATA_DIR=/absolute/path/Use Case 3/data
# KNOWLEDGE_BASE_DIR=/absolute/path/Use Case 3/knowledge_base
# UPLOAD_ROOT=/absolute/path/persistent/uploads
# GENERATED_DIR=/absolute/path/persistent/generated
RETRIEVAL_TOP_K=6
# Leave unset until evaluated for the chosen model/metric. Not a universal relevance threshold.
RETRIEVAL_MIN_SCORE=
CHUNK_SIZE=1600
CHUNK_OVERLAP=160
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=50000
UPLOAD_TOTAL_BYTES=1073741824
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
REQUEST_TIMEOUT_MS=180000
AI_TIMEOUT_SECONDS=20
AI_RETRIES=1
# VPS: set DOMAIN to your DNS name; ALLOWED_ORIGINS to its exact https origin.
DOMAIN=localhost
